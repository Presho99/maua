# Copy to .env.local for local development. Set these in Vercel for deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
# Required on Vercel. Use your pooled PostgreSQL URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Supabase, paste the full PEM certificate from Database Settings.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Set to the public origin on Vercel (no trailing slash).
APP_ORIGIN=http://localhost:3000
