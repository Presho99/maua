# Copy to .env.local for local development. Set these in Vercel for deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
# Required on Vercel. Use your Neon pooled PostgreSQL URL, including sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set to the public origin on Vercel (no trailing slash).
APP_ORIGIN=http://localhost:3000
